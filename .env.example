PORT=5000
NODE_ENV=production
# Comma-separated origins allowed to call /api from another domain.
# Leave empty when Express serves the client (same origin).
CORS_ORIGIN=
# Set to 1 when behind a proxy (Render, Railway, nginx) so rate limiting sees real IPs.
TRUST_PROXY=1
# Where requests are stored (JSON lines). Replace utils/store.js to use a database.
DATA_FILE=./data/requests.ndjson
